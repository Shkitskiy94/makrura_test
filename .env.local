# --- Приложение ---
APP_NAME=makrura
DEBUG=false

# Токен доступа к API (передаётся в заголовке X-Auth-Token)
API_TOKEN=hide_me_on_preprod

# --- База данных (docker-compose MySQL) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=monitor
MYSQL_USER=monitor
MYSQL_PASSWORD=monitor
MYSQL_HOST=percona
MYSQL_PORT=3306

# --- HTTP-сервер (Granian) ---
SERVER_BIND=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# --- Логирование ---
LOG_LEVEL=INFO
LOG_PRETTY=false

# --- Планировщик (APScheduler) ---
SCHEDULER_TZ=Europe/Moscow
CHECK_TIMES=03:00,15:00
ENABLE_SCHEDULER=true

# --- Поиск / площадки ---
VK_API_TOKEN=token
VK_API_VERSION=5.199
HTTP_TIME_OUT=15.0
SEARCH_RATE_LIMIT_SECONDS=2.0
FUZZY_MATCH_THRESHOLD=80
VIDEO_MIN_DURATION_SEC=600

# --- Загрузка/выгрузка ---
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports